    besoinMpParMois: [MonthDecimalValue!]!
}

type MonthValue {
  month: String!
  value: Int!
  year:Int!
  codeProduit:String!
}

type MonthDecimalValue {
  month: String!
  value: Float!
  year:Int!
  codeProduit:String! 
}
type MonthlyNeed {
    month: String!
    value:  Float!
    stockFinMois: Float!
  }

type Plan {
   id: ID!
    ref: String
    libelle: String
    mois: String
    prevueLancer: Int
    lancerActuelle: Int
    resteLancer: Int
    tailleLot: Int
    year: Int
   produit: Produit

}
type Produit {
    id: ID!
    libelle: String!
    reference: String!
    tailleLot: Int!

}
type rotationMp {
    idRotation: ID!
    dispoof: Float
}

type PageInfo {
    pageNumber: Int!
    pageSize: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

type StockPage {
    content: [Stock!]!
    pageInfo: PageInfo!
}

type GlobalstockPage {
    content: [Globalstock!]!
    pageInfo: PageInfo!
}

type MvstStockPage{
    content : [Mvst!]!
    pageInfo: PageInfo!
}

type CdePage{
    content:[Cde!]!
    pageInfo: PageInfo!
}
type PagedResponseBomN {
    content: [BomN]
    pageInfo: PageInfo
}
type rotationPage{
    content : [rotationMp!]!
    pageInfo : PageInfo!
}
type PlanPage {
  content: [Plan!]!
  pageInfo: PageInfo!
}
