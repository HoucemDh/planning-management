type StockAnalysis {
    analysis: String
    recommendedAction: String
    confidence: Float 
}

type AuthError {
    message: String!
    code: String!
}

type User_Roles {
    id: ID!
    name: String!
}

type AppUser {
    id: ID!
    username: String!
    email: String!
    roles: [User_Roles]!
    auditLogs: [AuditLog]
    active : Boolean
}

type AuthResponse {
    token: String!
    appUser: AppUser!
}

type LogoutResponse {
    success: Boolean!
    message: String!
}

type RoleResponse {
    success: Boolean!
    message: String!
    User_Roles: User_Roles
}

input LoginInput {
    username: String!
    password: String!
}

input UserInput {
  username: String!
  email: String!
  password: String!
  roleIds: [ID!]
}

type UserPayload {
  id: ID
  username: String
  email: String
  active: Boolean
  roles: [Role]
  message: String
}


input RoleInput {
    name: String!
}

type RolePayload {
    id: ID
    name: String!
    message: String!
}

type Role {
    id: ID!
    name: String!
}

type AuditLog {
    id: ID!
    action: String!
    details: String!
    ipAddress: String
    createdAt: String!
    user: AppUser
}
type AuditLogs {
  id: ID!
  action: String!
  username: String!
  entityType: String
  entityId: String
  oldValue: String
  newValue: String
  timestamp: String
}





input BomNInput {
    codeproduit: String!
    categorieProduit: String
    libellesPf: String
    libellesMp: String
    taillelot: String
    article: String
    qteBesoin: Float
    unite: String
}




type Mutation {
    generateRotationMp: Boolean!
    addPlan(libelle: String!, mois: String!, prevueLancer: Int!, lancerActuelle: Int!, tailleLot: Int!, year: Int!): Plan
       
    updatePlanByLibelle(libelle: String!, year: Int!, mois: String!, prevueLancer: Int!, lancerActuelle: Int!): Plan

    updateAllBesoinMoisForYear(year: Int!): Boolean

    updateAllStockValues: Boolean!
    updateAllStockValuesForYearAndMonth(year: Int!, month: String!): Boolean!

    calculateFieldsForAll: String

    updateBesoinMoisForArticle(year: Int!, articleCode: String!): Stock!



    login(input: LoginInput!): AuthResponse!
    logout: LogoutResponse!
    createRole(input: RoleInput!): RolePayload!
    updateRole(id: ID!, input: RoleInput!): RolePayload
    createUser(input: UserInput!): UserPayload!
    updateUser(id: ID!, input: UserInput!): UserPayload
    deactivateUser(id: ID!): UserPayload
    reactivateUser(id: ID!): UserPayload
    deleteRole(id : ID!): Boolean!



     affecterProduitsAuPdp: String

    addBomN(
        codeproduit: String!,
        categorieProduit: String,
        libellesPf: String,
        libellesMp: String,
        taillelot: String,
        article: String!,
        qteBesoin:  Int!,
        unite: String
    ): BomN


mettreAJourBomN(
        id: ID!,
        codeproduit: String,
        categorieProduit: String,
        libellesPf: String,
        libellesMp: String,
        taillelot: String,
        article: String,
        qteBesoin: Int,
        unite: String
    ): BomN



 generateBomN(year: Int!): [BomN]






  #ai
  AnalysisResult(designation: String!): StockAnalysis 
