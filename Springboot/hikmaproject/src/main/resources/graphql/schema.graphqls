    getBomPages(page: Int!, size: Int!, query: String): PagedResponseBom!
    getStockPages(page: Int!, size: Int!, query: String): PagedResponseStock!
    getBomNPages(page: Int!, size: Int!, query: String): PagedResponseBomN
    
    getPlans: [Plan]
    getPlansByYear(year: Int!): [Plan]
    getLibelles: [String]
    getProductByLibelle(libelle: String!): Produit
    searchPlans(year: Int!, libelle: String!): [Plan]

    

  
    getBomNById(id: ID!): BomN
    getAllBomN: [BomN]
   
    calculateDispoOf(stockId: ID!): Float

    getPdpsByMonthAndYear(mois: String!, year: Int!): [String]
    getBomsByCodeProduit(codeproduit: String!): [String]
    recupererResteLancerParMois(year: Int!): [BomN]


