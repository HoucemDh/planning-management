  shareAnalysisByEmail(designation: String!, email: String!): Boolean!





}


type Query {

   getAllStocks: [Stock!]!

    getAllArticles(page: Int = 0, size: Int = 20, query: String = ""): GlobalstockPage!
    getAllCde(page: Int = 0, size: Int = 20, query: String = ""): CdePage!
    getMvstPages(page: Int = 0, size: Int = 20, query: String = ""): MvstStockPage!
